#! /usr/bin/perl

use lib qw( /usr/local/psf/lib );
use Digest::SHA1 qw( sha1_hex );
use Data::Dumper;
use EV;
use JSON::XS;
use Mojolicious::Lite;
use PSF::Server;
use Try::Tiny;

our $json   = (new JSON::XS())->boolean_values( 0, 1 );
our $server = new PSF::Server();
our $DEBUG  = 0;

# ------------------------------------------------------------
# MANAGE RINGS, DIVISIONS, AND ATHLETES VIA WEBSOCKETS
# ------------------------------------------------------------
websocket '/:ring/:role' => sub {
	my $self   = shift;
	my $rnum   = $self->param( 'ring' );
	my $client = $server->registry->add( $self );

	$self->inactivity_timeout( 3600 ); # 1 hour
	$client->ping->start();

	# ----------------------------------------
	# Handle messages
	# ----------------------------------------
	$self->on( message => sub {
		my $self    = shift;
		my $request = $json->decode( shift );

		# ===== REJECT UNAUTHORIZED USERS
		my $security = $server->config->security();
		if( $security->enabled() ) {
			unless( $security->authenticated( $client ) && $security->authorized( $rnum )) {
				my $response = { error => $security->unauthorized(), request => $request };
				$server->send->client( $response );
				return;
			}
		}

		$request->{ ringid } = $rnum;
		$request->{ from } = $client->cid();

		# ===== HANDLE REQUEST
		try { 
			$server->handle( $request ); 

		} catch { 
			my $response = { error => "Error while processing request: $_\n", request => $request };
			$server->send->client( $response ); 

		};
		print STDERR "\n" if $DEBUG;
	});

	# ----------------------------------------
	# Handle disconnects
	# ----------------------------------------
	$self->on( finish => sub { 
		my $request  = { subject => 'client', action => 'disconnect', from => $server->id(), ring => $rnum };
		my $response = { subject => 'client', ringid => $rnum, client => { sessid => $client->sessid(), id => $client->id(), role => $client->role() }, request => $request };
		$client->ping->quit();
		$server->send->group( $response );
		$server->registry->remove( $client );
	});
};

# ============================================================
# STATUS
# ============================================================
get '/status' => sub {
	my $self = shift;
	$self->res->headers->header( 'Access-Control-Allow-Origin' => $server->config->host() );
	$self->render( text => 'OK' );
};

# ============================================================
# ERROR TRAPPING
# ============================================================
any '*command' => sub {
	my $self = shift;
	my $command = $self->param( 'command' );
	$self->res->headers->header( 'Access-Control-Allow-Origin' => $server->config->host() );
	$self->render( json => { error => "PSF Service Error: Unknown command: $command" });
};

# ============================================================
# HYPNOTOAD SERVER
# ============================================================
app->config( hypnotoad => { listen => [ 'http://*:3030' ], pid_file => '/var/run/psf.pid', workers => 1 });
app->log( new Mojo::Log( path => '/var/log/psf.log', level => 'debug' ));
app->start();
